{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "strudeland",
  "version": "0.1.2",
  "identifier": "com.rudoi.strudeland",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "strudeland", "width": 1280, "height": 800, "minWidth": 720, "minHeight": 480 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": "Entitlements.plist" }
  }
}
