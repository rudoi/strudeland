<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Keep the machine PATH entry under Program Files even if the GUI uses a custom directory. -->
    <DirectoryRef Id="ProgramFiles64Folder">
      <Directory Id="StrudelandCliDir" Name="Strudeland CLI">
        <Component Id="StrudelandCli" Guid="E55DCB75-266B-45AA-A9E1-4EF6687D7565" Win64="yes">
          <File Id="StrudelandCliExe" Name="strudeland.exe"
                Source="$(env.STRUDELAND_CLI_MSI_SOURCE)" KeyPath="yes" />
          <Environment Id="StrudelandCliPath" Name="PATH" Value="[StrudelandCliDir]"
                       Action="set" Part="last" System="yes" />
        </Component>
      </Directory>
    </DirectoryRef>
  </Fragment>
</Wix>
